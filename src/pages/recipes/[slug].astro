---
import Base from '../../layouts/Base.astro';
import { siteContent, url } from '../../lib/site';
export function getStaticPaths(){return siteContent.recipes.map((recipe)=>({params:{slug:recipe.slug},props:{recipe}}))}
const { recipe } = Astro.props;
const isServings = /^servings?$/i.test(recipe.yield.unit);
---
<Base title={recipe.title} description={recipe.description} showBack>
  <button slot="header-action" class="favorite-button header-favorite" type="button" data-favorite={recipe.id} aria-label={`Add ${recipe.title} to favorites`} aria-pressed="false">♡</button>
  <article class="reading-page recipe-detail" data-recipe data-base-yield={recipe.yield.amount}>
    <header><h1>{recipe.title}</h1></header>
    <div class:list={['recipe-hero', `category-${recipe.categorySlug}`]}>{recipe.image && <img src={url(recipe.image)} alt={`${recipe.title}`} />}</div>
    <p class="lead">{recipe.description}</p>
    <div class="serving-control"><strong>{isServings ? 'Serves' : 'Makes'}</strong><button type="button" data-decrease aria-label="Decrease amount">−</button><output data-serving>{recipe.yield.amount}</output><button type="button" data-increase aria-label="Increase amount">+</button><span class="yield-unit">{isServings ? '' : recipe.yield.unit}</span><button class="reset-serving" type="button" data-reset hidden>Reset</button></div>
    <div class="recipe-actions"><button type="button" data-share><span aria-hidden="true">↗</span>Share</button><button type="button" data-print><span aria-hidden="true">▣</span>Print</button><button type="button" data-cook aria-pressed="false"><span aria-hidden="true">◉</span>Cook Mode</button></div>
    <section id="ingredients"><h2>Ingredients</h2><div class="prose ingredients" data-ingredients set:html={recipe.ingredientsHtml}></div></section>
    <section id="instructions"><h2>Instructions</h2><div class="prose" set:html={recipe.instructionsHtml}></div></section>
    {recipe.variationsHtml && <section><h2>Variations</h2><div class="prose" set:html={recipe.variationsHtml}></div></section>}
    {recipe.notesHtml && <section><h2>Notes</h2><div class="prose" set:html={recipe.notesHtml}></div></section>}
  </article>
  <script>
    const FAVORITES_KEY='cookbook-favorites';const favorite=document.querySelector('[data-favorite]');function refreshFavorite(){const saved=new Set(JSON.parse(localStorage.getItem(FAVORITES_KEY)||'[]'));const on=saved.has(favorite.dataset.favorite);favorite.textContent=on?'♥':'♡';favorite.setAttribute('aria-pressed',String(on));favorite.setAttribute('aria-label',`${on?'Remove':'Add'} recipe ${on?'from':'to'} favorites`)}favorite.addEventListener('click',()=>{const saved=new Set(JSON.parse(localStorage.getItem(FAVORITES_KEY)||'[]'));saved.has(favorite.dataset.favorite)?saved.delete(favorite.dataset.favorite):saved.add(favorite.dataset.favorite);localStorage.setItem(FAVORITES_KEY,JSON.stringify([...saved]));refreshFavorite()});refreshFavorite();window.addEventListener('pageshow',refreshFavorite);
    const page=document.querySelector('[data-recipe]');const baseAmount=Number(page.dataset.baseYield);let current=baseAmount;const output=document.querySelector('[data-serving]');const reset=document.querySelector('[data-reset]');const items=[...document.querySelectorAll('[data-ingredients] li')];items.forEach(item=>item.dataset.original=item.textContent);
    const unicode={'¼':.25,'½':.5,'¾':.75,'⅓':1/3,'⅔':2/3,'⅛':.125,'⅜':.375,'⅝':.625,'⅞':.875};
    function parseNumber(text){const mixed=text.match(/^(\d+)\s+(\d+)\/(\d+)/);if(mixed)return{value:+mixed[1]+(+mixed[2]/+mixed[3]),length:mixed[0].length};const fraction=text.match(/^(\d+)\/(\d+)/);if(fraction)return{value:+fraction[1]/+fraction[2],length:fraction[0].length};const uni=text.match(/^(\d+)?\s*([¼½¾⅓⅔⅛⅜⅝⅞])/);if(uni)return{value:+(uni[1]||0)+unicode[uni[2]],length:uni[0].length};const decimal=text.match(/^\d+(?:\.\d+)?/);return decimal?{value:+decimal[0],length:decimal[0].length}:null}
    const fractions=[[0,''],[.125,'⅛'],[1/6,'⅙'],[.25,'¼'],[1/3,'⅓'],[.375,'⅜'],[.5,'½'],[.625,'⅝'],[2/3,'⅔'],[.75,'¾'],[.875,'⅞'],[1,'']];function format(value,wholeOnly=false){if(wholeOnly)return String(Math.max(1,Math.round(value)));let whole=Math.floor(value);let part=value-whole;let nearest=fractions.reduce((a,b)=>Math.abs(b[0]-part)<Math.abs(a[0]-part)?b:a);if(nearest[0]===1){whole++;nearest=fractions[0]}return`${whole||''}${nearest[1]}`||'0'}
    function scaleText(text,factor){const leading=text.match(/^\s*/)[0];const rest=text.slice(leading.length);const first=parseNumber(rest);if(!first)return text;const after=rest.slice(first.length).trimStart();const measured=/^(?:tsp|Tbs|tbsp|tablespoons?|teaspoons?|cups?|c\b|quarts?|qt\b|pints?|pt\b|gallons?|gal\b|ounces?|oz\b|pounds?|lbs?\b|grams?|g\b|kilograms?|kg\b|ml\b|milliliters?|liters?|l\b)/i.test(after);let result=format(first.value*factor,!measured)+rest.slice(first.length);const range=result.match(/^([^–-]+)([–-])(\s*)(\d+(?:\.\d+)?|\d+\/\d+)/);if(range){const second=parseNumber(range[4]);if(second)result=`${range[1]}${range[2]}${range[3]}${format(second.value*factor,!measured)}${result.slice(range[0].length)}`}return leading+result}
    function render(){const factor=current/baseAmount;output.value=format(current);items.forEach(item=>item.textContent=scaleText(item.dataset.original,factor));reset.hidden=current===baseAmount}
    document.querySelector('[data-decrease]').addEventListener('click',()=>{current=Math.max(1,current-1);render()});document.querySelector('[data-increase]').addEventListener('click',()=>{current++;render()});reset.addEventListener('click',()=>{current=baseAmount;render()});
    document.querySelector('[data-print]').addEventListener('click',()=>window.print());document.querySelector('[data-share]').addEventListener('click',async()=>{const share={title:document.title,text:document.querySelector('.lead').textContent,url:location.href};try{if(navigator.share)await navigator.share(share);else{await navigator.clipboard.writeText(location.href);alert('Recipe link copied.')}}catch(error){if(error.name!=='AbortError')alert('Unable to share this recipe.')}});
    let wakeLock=null;const cook=document.querySelector('[data-cook]');async function stopCook(){if(wakeLock){await wakeLock.release();wakeLock=null}cook.setAttribute('aria-pressed','false');cook.classList.remove('selected')}cook.addEventListener('click',async()=>{if(wakeLock)return stopCook();try{wakeLock=await navigator.wakeLock.request('screen');cook.setAttribute('aria-pressed','true');cook.classList.add('selected');wakeLock.addEventListener('release',()=>{wakeLock=null;cook.setAttribute('aria-pressed','false');cook.classList.remove('selected')})}catch{alert('Cook Mode is not supported by this browser.')}});window.addEventListener('pagehide',stopCook);
  </script>
</Base>
